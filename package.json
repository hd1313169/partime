{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:client\" \"npm run dev:worker\"",
    "dev:client": "vite --port=3000 --host=0.0.0.0",
    "dev:worker": "wrangler dev --env staging --port 8787",
    "dev:server": "tsx watch server/index.ts",
    "build": "vite build",
    "build:worker": "wrangler deploy --env staging --dry-run",
    "build:worker:production": "wrangler deploy --env production --dry-run",
    "deploy": "node -e \"console.error('Use npm run deploy:staging or npm run deploy:production'); process.exit(1)\"",
    "deploy:staging": "npm run build && npm run build:worker && wrangler deploy --env staging",
    "deploy:production": "npm run build && npm run build:worker:production && wrangler deploy --env production",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "verify": "npm run lint && npm run test",
    "verify:cloudflare": "npm run lint && npm run test:worker && npm run build && npm run build:worker",
    "test": "npm run test:server && npm run test:client",
    "test:server": "vitest run tests/server --reporter=verbose",
    "test:client": "vitest run tests/client --reporter=verbose",
    "test:worker": "vitest run tests/worker --reporter=verbose",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@google/genai": "^1.29.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "better-sqlite3": "^12.4.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "hono": "^4.10.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^3.7.0",
    "tailwind-merge": "^3.5.0",
    "vite": "^6.2.0"
  },
  "devDependencies": {
    "@types/supertest": "^6.0.3",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.0.1",
    "@cloudflare/workers-types": "^4.20260415.0",
    "jsdom": "^25.0.1",
    "supertest": "^7.0.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vitest": "^2.1.8",
    "wrangler": "^4.11.1"
  }
}
